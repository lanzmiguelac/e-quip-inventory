{
  "name": "e-quip",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:integration": "node --env-file=.env tests/integration.mjs",
    "test:unit": "vitest run tests/rules.test.ts tests/google-auth.test.ts tests/login.test.tsx tests/qr-camera.test.tsx tests/access-request-ui.test.tsx tests/admin-access-requests.test.tsx",
    "test:accounts": "node --env-file=.env tests/admin-api.mjs",
    "test:storage": "node --env-file=.env tests/storage.mjs",
    "test:google": "node --env-file=.env tests/google-approval.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "html5-qrcode": "2.3.8",
    "lucide-react": "1.70.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "31.0.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
